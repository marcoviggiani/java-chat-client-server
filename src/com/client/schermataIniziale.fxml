<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<Pane fx:id="pane" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
      prefHeight="400.0" prefWidth="600.0"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.client.LoginController">

   <children>
      <Label layoutX="240.0" layoutY="14.0" text="Chat">
         <font>
            <Font size="59.0" />
         </font>
      </Label>

      <Label layoutX="33.0" layoutY="155.0" text="Username: ">
         <font>
            <Font size="25.0" />
         </font>
      </Label>

      <TextField fx:id="textFieldUsername" layoutX="214.0" layoutY="157.0" promptText="username" />

      <Button fx:id="buttonChat" layoutX="214.0" layoutY="305.0"
              mnemonicParsing="false"
              onAction="#enterInChat"
              text="Enter in the Chat">
         <font>
            <Font size="25.0" />
         </font>
      </Button>

      <Label layoutX="48.0" layoutY="234.0" text="IP Server: ">
         <font>
            <Font size="25.0" />
         </font>
      </Label>

      <TextField fx:id="textFieldIpServer" layoutX="205.0" layoutY="239.0" promptText="IP Server" />
   </children>
</Pane>